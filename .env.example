# Bankio external configuration. Copy to .env and edit before `docker compose up`.
# NEVER commit .env. Every CHANGE_ME value must be replaced.
# Sensitive values may alternatively be provided via *_FILE (Docker Secrets),
# e.g. DJANGO_SECRET_KEY_FILE=/run/secrets/django_secret_key.

# ---------------------------------------------------------------- APPLICATION
BANKIO_ENV=development            # development | production
DJANGO_DEBUG=true                 # MUST be false outside local development
DJANGO_SECRET_KEY=CHANGE_ME       # generate: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DJANGO_TIME_ZONE=UTC

# Set true only when serving behind HTTPS; keeps localhost HTTP working when false.
BANKIO_SECURE_COOKIES=false
BANKIO_SSL_REDIRECT=false

# ---------------------------------------------------------------------- SERVER
BANKIO_PORT=8000                  # host port for the web service

# -------------------------------------------------------------------- DATABASE
POSTGRES_DB=bankio
POSTGRES_USER=bankio
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5434           # host port exposed by the db container (optional access)

# -------------------------------------------------------------- INITIAL ADMIN
# Used by: docker compose run --rm web python manage.py bootstrap_admin
BANKIO_ADMIN_USERNAME=admin
BANKIO_ADMIN_EMAIL=admin@example.com
BANKIO_ADMIN_PASSWORD=CHANGE_ME
